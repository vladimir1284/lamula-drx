# mkdocs / wrangler build artifacts
site/
.wrangler/

# secrets
.env

# Vivado / Vitis (flujo no-project: solo se versiona tcl/, rtl/, ip/*.xci)
*.jou
*.log
*.str
.Xil/
.srcs/
.gen/
vivado*.backup.jou
vivado*.backup.log
build/
runs/
*.bit
*.bin
*.elf
*.xsa

# Productos de IP regenerados por tcl/gen_ip.tcl / tcl/ip.tcl a partir del
# XCI -- el XCI es la única fuente versionada bajo ip/*/
ip/*/hdl/
ip/*/sim/
ip/*/constraints/
ip/*/cmodel/
ip/*/demo_tb/
ip/*/doc/
ip/*/synth/
ip/*/*.veo
ip/*/*.vho
ip/*/*.xml
ip/*/*.mif
# Vivado deja .mif de los FIR Compiler en el directorio desde el que se lanza,
# que es la raiz del repo. Son byproducts del IP, no fuentes.
*.mif
ip/*/*.dcp
ip/*/*_sim_netlist.v
ip/*/*_sim_netlist.vhdl
ip/*/*_stub.v
ip/*/*_stub.vhdl
ip/*/*_ooc.xdc

# `ip_debug/` es el ILA de depuracion de P-21 (tcl/gen_ip_debug.tcl). Mismo
# criterio que `ip/`: solo el XCI se versiona. Directorio aparte para que el
# glob de `tcl/build.tcl` no lo arrastre a la build normal.
ip_debug/*/hdl/
ip_debug/*/sim/
ip_debug/*/synth/
ip_debug/*/doc/
ip_debug/*/ila_v6_2/
ip_debug/*/*.veo
ip_debug/*/*.xml
ip_debug/*/*.dcp
ip_debug/*/*_ooc.xdc
ip_debug/*/*_sim_netlist.v
ip_debug/*/*_sim_netlist.vhdl
ip_debug/*/*_stub.v
ip_debug/*/*_stub.vhdl

# Datasheets de fabricante descargados como referencia de trabajo -- no se
# versionan (copyright del fabricante); lo que sí se versiona va en
# docs/referencia/
/pg141-dds-compiler-en-us-6.0.pdf

# Entorno de Python del repositorio
.venv/

# Python (modelo dorado, cocotb)
__pycache__/
*.pyc
.venv/
.pytest_cache/
sim_build/
results.xml
dump.vcd
*.fst
